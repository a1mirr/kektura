{
  "name": "kektura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "testdb:start": "supabase start",
    "testdb:stop": "supabase stop",
    "testdb:reset": "supabase db reset",
    "types:gen": "node scripts/db-types.mjs gen",
    "types:check": "node scripts/db-types.mjs check",
    "telegram:check": "node scripts/telegram-check.mjs",
    "predev:test": "node scripts/copy-maplibre-worker.mjs",
    "dev:test": "node scripts/test-env.mjs next dev --port 3001",
    "prebuild:e2e": "node scripts/copy-maplibre-worker.mjs",
    "build:e2e": "node scripts/test-env.mjs --e2e next build",
    "start:e2e": "node scripts/test-env.mjs --e2e next start --port 3002",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.7",
    "next-intl": "^4.14.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.3"
  }
}
