NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Feedback form notifications (spec 0017), server-only: never prefix with NEXT_PUBLIC_.
# Create a bot with @BotFather, then `npm run telegram:check -- --find-chat-id` prints the chat id.
# Without both values, feedback is only stored in the database.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
