NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Feedback form notifications (spec 0017), server-only: never prefix with NEXT_PUBLIC_.
# Create a bot with @BotFather, then `npm run telegram:check -- --find-chat-id` prints the chat id.
# Without both values, feedback is only stored in the database. The same bot and chat also get a message when a server
# action fails in production (spec 0008), at most one per kind of failure and hour.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Feature flag commands from the Telegram bot (spec 0035), server-only, production only: the secret Telegram sends back with
# every update (A-Z a-z 0-9 _ -, make one up), and the Supabase service role (secret) key, used by that route alone.
# Without them /api/telegram answers 404. Register the webhook with `npm run telegram:webhook -- set`.
TELEGRAM_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
